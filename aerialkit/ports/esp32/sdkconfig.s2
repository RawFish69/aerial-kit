# The ESP32-S2 half of the family's build configuration. See sdkconfig.s3 for
# why the chip is a separate file applied after the platform defaults.

CONFIG_IDF_TARGET="esp32s2"

# The DevKitM-1 carries 4 MB of flash. The partition table is the same 1.25 MB
# application and 704 KB log as the ESP32's.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
