# The ESP32-S3 half of the family's build configuration.
#
# `sdkconfig.defaults` is the platform's (stack, ticks, the partition table, the
# log level, the network); this is the chip's, and it is applied after it so it
# wins where the two disagree. It is a separate file, like `sdkconfig.wifi`, for
# the same reason: IDF keeps the sdkconfig it generated and quietly ignores a
# default that changed behind it, so the chip has to be a *choice of build* with
# its own directory, not an edit to the shared file.

CONFIG_IDF_TARGET="esp32s3"

# The DevKitC-1 the board file is written for carries 8 MB of flash. The
# partition table is the same 1.25 MB application and 704 KB log as the ESP32's
# - the log is the point of the table, and it fits twice over on this part.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
