 #include <functional>
 #include <Wire.h>

+#if defined(AERIALKIT_ROLE_SELECT_PIN)
+#include "aerialkit_boot_logic.h"
+
+static void enforceAerialKitRoleSelect()
+{
+    pinMode(AERIALKIT_ROLE_SELECT_PIN, INPUT);
+    const bool roleHigh = digitalRead(AERIALKIT_ROLE_SELECT_PIN) == HIGH;
+#if defined(TARGET_TX)
+    const bool matches = aerialkit_role_matches(roleHigh, false);
+#elif defined(TARGET_RX)
+    const bool matches = aerialkit_role_matches(roleHigh, true);
+#else
+    const bool matches = true;
+#endif
+
+    if (matches)
+    {
+        return;
+    }
+
+    if (GPIO_PIN_TX_ENABLE != UNDEF_PIN)
+    {
+        pinMode(GPIO_PIN_TX_ENABLE, OUTPUT);
+        digitalWrite(GPIO_PIN_TX_ENABLE, LOW);
+    }
+    if (GPIO_PIN_RX_ENABLE != UNDEF_PIN)
+    {
+        pinMode(GPIO_PIN_RX_ENABLE, OUTPUT);
+        digitalWrite(GPIO_PIN_RX_ENABLE, LOW);
+    }
+    while (true)
+    {
+        delay(1000);
+    }
+}
+#endif
+
